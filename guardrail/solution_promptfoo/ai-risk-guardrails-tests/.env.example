# AI Risk Manager - Guardrails Testing Environment Variables
# Copy this file to .env and add your actual API keys

# === LLM Provider API Keys ===

# Google Gemini API (Vertex AI or AI Studio)
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI API
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude (optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# === Backend API Configuration (if testing your own API) ===

# Your AI Risk Manager Backend API
API_URL=http://localhost:3003/api/tests/evaluate
API_KEY=your_backend_api_key_here

# === Promptfoo Configuration ===

# Disable remote generation (keep tests local)
PROMPTFOO_DISABLE_REMOTE_GENERATION=true

# Number of concurrent tests (lower = slower but safer for rate limits)
PROMPTFOO_MAX_CONCURRENCY=5

# Cache directory (optional)
PROMPTFOO_CACHE_PATH=./.promptfoo-cache

# === Optional: Test Configuration ===

# Number of tests per plugin (default: 10)
# Set to 5 for quick tests, 20 for thorough tests
REDTEAM_NUM_TESTS=10

# Test timeout in milliseconds (default: 30000)
TEST_TIMEOUT=60000
