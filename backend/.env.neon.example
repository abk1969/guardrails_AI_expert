# Neon PostgreSQL Configuration
# Get these values from https://console.neon.tech
#
# Pooled connection (for application queries via PgBouncer)
DATABASE_URL="postgresql://username:password@ep-cool-name-123456.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
#
# Direct connection (for migrations and Prisma introspection)
DIRECT_URL="postgresql://username:password@ep-cool-name-123456.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
#
# Other backend env vars (copy from .env)
JWT_SECRET="your-production-jwt-secret-min-32-chars"
REDIS_URL="redis://localhost:6379"
GEMINI_API_KEY="your-gemini-api-key"
