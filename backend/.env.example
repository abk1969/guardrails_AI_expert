# ===================================
# AI RISK MANAGER - Backend Environment Variables
# ===================================

# ===== Application =====
NODE_ENV=development
PORT=3000
APP_NAME="AI Risk Manager Backend"

# ===== Frontend CORS =====
FRONTEND_URL=http://localhost:5080
CORS_ORIGIN=http://localhost:5080

# ===== Database (PostgreSQL) =====
DATABASE_URL=postgresql://airisk:airisk123@postgres:5432/ai_risk_manager?schema=public
# Direct connection URL (required for Neon PostgreSQL with PgBouncer connection pooling)
# For local development with Docker, this can be the same as DATABASE_URL
# For Neon, use the direct (non-pooled) connection string
DIRECT_URL=postgresql://airisk:airisk123@postgres:5432/ai_risk_manager?schema=public

# ===== JWT Authentication =====
JWT_SECRET=change_this_to_a_secure_random_secret_key_in_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change_this_to_another_secure_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# ===== Redis (Cache & Sessions) =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== Rate Limiting =====
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ===== File Upload =====
MAX_FILE_SIZE=10485760
# 10MB in bytes

# ===== Logging =====
LOG_LEVEL=debug
# Options: error, warn, info, debug

# ===== Email (optional, pour notifications) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=AI Risk Manager <noreply@airiskmanager.com>

# ===== External APIs (optional) =====
# Gemini API pour génération de prompts côté backend
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API pour tests LLM
OPENAI_API_KEY=your_openai_api_key_here

# ===== Promptfoo Integration =====
PROMPTFOO_CONFIG_DIR=../guardrail/solution_promptfoo/ai-risk-guardrails-tests
PROMPTFOO_RESULTS_DIR=../results

# ===== Security =====
# Bcrypt salt rounds
BCRYPT_ROUNDS=12

# Session secret
SESSION_SECRET=change_this_to_a_secure_session_secret

# ===== WebSocket =====
WS_PORT=3000
# WebSocket utilise le même port que l'API REST

# ===== Monitoring (optional) =====
SENTRY_DSN=
# Sentry DSN for error tracking

# ===== Feature Flags =====
ENABLE_SWAGGER=true
ENABLE_WEBSOCKETS=true
ENABLE_REAL_TIME_TESTS=true
