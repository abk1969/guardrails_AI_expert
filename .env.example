# ==============================================
# AI RISK MANAGER - Environment Configuration
# ==============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ----------------------------------------------
# Database Configuration
# ----------------------------------------------
DATABASE_URL="postgresql://airiskmgr:airiskmgr_dev_password@localhost:5432/airiskmgr_db"
DATABASE_POOL_SIZE=20
DATABASE_SSL=false

# ----------------------------------------------
# Redis Configuration
# ----------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password
REDIS_TLS=false

# ----------------------------------------------
# JWT Authentication
# ----------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_REFRESH_SECRET=your-refresh-token-secret-different-from-jwt-secret

# ----------------------------------------------
# Encryption (for sensitive data at rest)
# ----------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-32-character-encryption-key-here-change-in-prod

# ----------------------------------------------
# External AI APIs
# ----------------------------------------------
# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI API (optional)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic Claude API (optional)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ----------------------------------------------
# MCP (Model Context Protocol) Configuration
# ----------------------------------------------
# Frontend: URL of the MCP server backend
VITE_MCP_API_URL=http://localhost:3001/api/v1/mcp

# Frontend: Enable mock mode for MCP (when backend is unavailable)
VITE_MCP_MOCK_MODE=false

# ----------------------------------------------
# Rate Limiting
# ----------------------------------------------
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
THROTTLE_TEST_LIMIT=10

# ----------------------------------------------
# CORS Configuration
# ----------------------------------------------
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# ----------------------------------------------
# Application Configuration
# ----------------------------------------------
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# Frontend URL (for emails, webhooks, etc.)
FRONTEND_URL=http://localhost:3000

# ----------------------------------------------
# Email Configuration (SMTP)
# ----------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@airiskmgr.com

# ----------------------------------------------
# File Storage
# ----------------------------------------------
# Local storage path for uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# AWS S3 (optional, for production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
AWS_S3_BUCKET=airiskmgr-uploads

# ----------------------------------------------
# Logging
# ----------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs

# ----------------------------------------------
# Monitoring & Observability
# ----------------------------------------------
# Sentry (error tracking)
SENTRY_DSN=

# New Relic (APM)
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=AI-Risk-Manager

# Prometheus metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# ----------------------------------------------
# Feature Flags
# ----------------------------------------------
FEATURE_REAL_TEST_EXECUTION=false
FEATURE_MULTI_TENANCY=true
FEATURE_AUDIT_LOGGING=true
FEATURE_EMAIL_NOTIFICATIONS=false
FEATURE_WEBHOOK_NOTIFICATIONS=false

# ----------------------------------------------
# Queue Configuration (BullMQ)
# ----------------------------------------------
QUEUE_CONCURRENCY=5
QUEUE_MAX_RETRIES=3
QUEUE_BACKOFF_DELAY=5000

# ----------------------------------------------
# Security Headers
# ----------------------------------------------
HELMET_ENABLED=true
CSRF_ENABLED=true

# ----------------------------------------------
# Session Configuration
# ----------------------------------------------
SESSION_SECRET=your-session-secret-change-in-production
SESSION_MAX_AGE=86400000

# ----------------------------------------------
# Data Retention (GDPR Compliance)
# ----------------------------------------------
DATA_RETENTION_DAYS=90
ANONYMIZE_OLD_DATA=true

# ----------------------------------------------
# Testing
# ----------------------------------------------
TEST_DATABASE_URL="postgresql://airiskmgr:airiskmgr_test_password@localhost:5433/airiskmgr_test"
E2E_BASE_URL=http://localhost:3000
