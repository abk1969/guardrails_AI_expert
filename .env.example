# ===== Gemini API (pour génération de prompts de test) =====
VITE_GEMINI_API_KEY=AIzaSyBBchjHD_hVvbCXc026o2R-diRPpoTNqAs
# Obtenez une clé sur https://makersuite.google.com/app/apikey

# ===== Backend API (Phase 4) =====
VITE_BACKEND_URL=http://localhost:3000
# URL du backend NestJS pour mode backend avec WebSocket temps réel

# ===== JWT Authentication (Phase 4) =====
VITE_JWT_TOKEN=your_jwt_token_here
# Token JWT pour authentification backend (obtenu après login)
# Exemple d'obtention:
# curl -X POST http://localhost:3000/api/v1/auth/login \
#   -H "Content-Type: application/json" \
#   -d '{"email":"user@example.com","password":"password"}'

# ===== Configuration =====
# Mode par défaut: 'simulation' | 'real' | 'backend'
VITE_DEFAULT_TEST_MODE=simulation
