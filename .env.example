# =============================================================================
# AI Risk Manager - Variables d'environnement
# =============================================================================
# Copier ce fichier en .env et remplir les valeurs
# cp .env.example .env

# --- API Keys (OBLIGATOIRE pour le mode full-stack) ---
GEMINI_API_KEY=your_gemini_api_key_here
# Obtenez une clé sur https://makersuite.google.com/app/apikey
OPENAI_API_KEY=your_openai_api_key_here

# --- Frontend (Vite - préfixe VITE_ obligatoire) ---
VITE_API_URL=http://localhost:3003/api/v1
VITE_WS_URL=ws://localhost:3003
VITE_MCP_API_URL=http://localhost:3003/api/v1/mcp
VITE_MCP_MOCK_MODE=false
VITE_DEFAULT_TEST_MODE=simulation

# --- Backend Security (CHANGER EN PRODUCTION) ---
JWT_SECRET=change-this-to-a-strong-random-string-in-production
ENCRYPTION_KEY=change-this-to-32-chars-in-prod!

# --- CORS ---
CORS_ORIGIN=http://localhost:3004

# --- Strix LLM Configuration ---
STRIX_LLM=gemini/gemini-2.5-flash
LLM_API_BASE=
PERPLEXITY_API_KEY=
