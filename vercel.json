{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "devCommand": "npm run dev",
  "env": {
    "VITE_API_URL": "https://your-backend-api.vercel.app/api/v1",
    "VITE_MCP_API_URL": "https://your-backend-api.vercel.app/api/v1/mcp",
    "VITE_MCP_MOCK_MODE": "false"
  },
  "build": {
    "env": {
      "NODE_VERSION": "18"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
